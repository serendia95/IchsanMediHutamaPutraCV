entrypoint = "main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run"
mode = "sequential"
author = 44463483

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run main.py --server.enableCORS false"

[[workflows.workflow]]
name = "Run Streamlit"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run --server.port 5000 --server.address 0.0.0.0 --server.enableCORS false resume.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Streamlit"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
